set.seed(123)
# 1. Generar datos
n <- 10000
# Generamos dos variables para poder usar distancia euclídea
x <- rnorm(n)
y <- rnorm(n)
data <- data.frame(x = x, y = y)
# Número de clusters
k <- 3
# 2. Inicializar centroides aleatoriamente
centroids <- data[sample(1:n, k), ]
# Función para calcular distancia euclídea
compute_distance <- function(data, centroids) {
distances <- matrix(0, nrow = nrow(data), ncol = nrow(centroids))
for (i in 1:nrow(centroids)) {
distances[, i] <- sqrt((data$x - centroids$x[i])^2 + (data$y - centroids$y[i])^2)
}
return(distances)
}
# 3. Iterar hasta convergencia
max_iter <- 50
clusters <- rep(0, n)
centroid_history <- list()
clusters_history <- list()
for (iter in 1:max_iter) {
# Guardar centroides
centroid_history[[iter]] <- centroids
# Paso 1: asignación
distances <- compute_distance(data, centroids)
new_clusters <- apply(distances, 1, which.min)
# Guardar clusters
clusters_history[[iter]] <- new_clusters
# Paso 2: actualización de centroides
new_centroids <- centroids
for (j in 1:k) {
if (sum(new_clusters == j) > 0) {
new_centroids[j, ] <- colMeans(data[new_clusters == j, ])
}
}
# Comprobar convergencia
if (all(new_clusters == clusters)) {
cat("Convergencia alcanzada en iteración:", iter, "\n")
break
}
clusters <- new_clusters
centroids <- new_centroids
}
library(ggplot2)
plotdata <- data
plotdata$cluster <- as.factor(clusters)
# Últimos centroides
centroids$cluster <- as.factor(1:k)
# Gráfico final
plotdata %>%
ggplot(aes(x = x, y = y, color = cluster)) +
geom_point(alpha = 0.4) +
geom_point(data = centroids, aes(x = x, y = y), size = 5)
# Guardar evolución de centroides
centroid_df <- do.call(rbind, lapply(1:length(centroid_history), function(i) {
cbind(centroid_history[[i]], iter = i, cluster = 1:k)
}))
# Visualizar trayectorias de centroides
plotdata %>%
ggplot(aes(x = x, y = y)) +
geom_point(alpha = 0.1) +
geom_path(data = centroid_df, aes(x = x, y = y, group = cluster, color = as.factor(cluster))) +
geom_point(data = centroid_df, aes(x = x, y = y, color = as.factor(cluster)))
library(plotly)
# Construir dataset con iteraciones
interactive_df <- do.call(rbind, lapply(1:length(clusters_history), function(i) {
df <- data
df$cluster <- as.factor(clusters_history[[i]])
df$iter <- i
return(df)
}))
# Plot interactivo con slider
p <- plot_ly(
interactive_df,
x = ~x,
y = ~y,
color = ~cluster,
frame = ~iter,
type = 'scatter',
mode = 'markers'
)
p
