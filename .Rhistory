geom_density(position="identity", alpha=.35, adjust=2)+
scale_y_continuous(expand=c(0,0))+
scale_fill_manual(values=paleta_alt)+
scale_color_manual(values=paleta_alt)+
geom_vline(xintercept=0, linetype="long-dash")
